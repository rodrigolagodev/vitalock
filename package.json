{
  "name": "vitalock",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "bash scripts/gen-types.sh",
    "test:sql": "bash scripts/test-sql.sh",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "size": "turbo run size",
    "gen:schema-doc": "bash scripts/gen-schema-doc.sh",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "db:rehearse": "bash scripts/rehearse-migration.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "22.7.5",
    "@vitalock/config-typescript": "workspace:^",
    "@vitest/coverage-v8": "2.1.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "turbo": "2.1.3",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
