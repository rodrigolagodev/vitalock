# Vitalock environment variables template
# Copy this file to apps/admin/.env.local and apps/installer/.env.local
# Fill in real values — do NOT commit .env.local files

# Supabase project URL (exposed to browser via Vite)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/public key (exposed to browser via Vite)
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Server-side equivalents (no VITE_ prefix — NOT exposed to browser)
# Used by scripts and server-side code only
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# Optional — base path the SPA is served from (default /). Set by pages.yml on GitHub Pages.
# VITE_BASE_PATH=/

# Optional — endpoint for batched client error reports. Leave unset to disable reporting.
# VITE_ERROR_REPORTING_ENDPOINT=
